# ─────────────────────────────────────────────────────────────
# Sequel — Production Android .gitignore
# ─────────────────────────────────────────────────────────────

# ── Built Artifacts ─────────────────────────────────────────
*.apk
*.ap_
*.aab
*.apks
*.aar
*.dex
*.class
*.idsig

# ── Generated / Build Outputs ───────────────────────────────
bin/
gen/
out/
build/
*/build/
app/build/
app/release/
reports/

# ── Gradle ──────────────────────────────────────────────────
.gradle/
buildOutputCleanup/
.gradle-build/

# ── Local Configuration & Secrets (NEVER commit) ────────────
local.properties
keystore.properties
secrets.properties
*.env
*.env.*
.env
.env.local

# ── Signing & Certificates (NEVER commit) ───────────────────
*.jks
*.keystore
*.key
*.pem
*.p12
*.pfx
*.pkcs12
*.pepk
private_key.pepk
release.keystore

# ── Google Services & Crashlytics ───────────────────────────
google-services.json
google-services-*.json
crashlytics-build.properties
crashlytics.properties
com.google.firebase.crashlytics/
.firebase/

# ── ProGuard & R8 Code Shrinking Outputs ────────────────────
proguard/
mapping.txt
seeds.txt
usage.txt
dump.txt
*.mapping

# ── Room Schemas (Must be tracked in git for migrations) ────
!app/schemas/
!app/schemas/**

# ── Logs & JVM Crash Dumps ──────────────────────────────────
*.log
hs_err_pid*
replay_pid*
*.hprof
*.dump

# ── IntelliJ / Android Studio ───────────────────────────────
*.iml
.idea/
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild
.cxx/
.shelf/

# ── Kotlin Compiler ─────────────────────────────────────────
.kotlin/

# ── Editors & IDEs ──────────────────────────────────────────
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej

# ── Operating System Junk ───────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ── Scratch, Local Scripts & Test Stubs (Anchored to Root) ──
/test/
/skills/
/scratch/
/test*.kt
/test*.md
/Dump.kt
/install.cmd
*.py

# ── Web Development / Node ──────────────────────────────────
node_modules/
.npm/
dist/
.cache/