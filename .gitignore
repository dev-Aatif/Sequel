# ─────────────────────────────────────────────────────────────
# Sequel — .gitignore
# ─────────────────────────────────────────────────────────────

# ── Built Artifacts ─────────────────────────────────────────
*.apk
*.ap_
*.aab

# ── Bytecode / VM ───────────────────────────────────────────
*.dex
*.class

# ── Generated / Build Outputs ───────────────────────────────
bin/
gen/
out/
build/
*/build/

# ── Gradle ──────────────────────────────────────────────────
.gradle/

# ── Local Configuration (SDK paths, API keys) ──────────────
local.properties

# ── Signing & Credentials (NEVER commit) ────────────────────
*.jks
*.keystore
*.key
keystore.properties

# ── ProGuard (Eclipse-generated, legacy) ────────────────────
proguard/

# ── Logs ────────────────────────────────────────────────────
*.log

# ── Android Studio Navigation Editor ───────────────────────
.navigation/

# ── Android Studio Captures ─────────────────────────────────
captures/

# ── IntelliJ / Android Studio ──────────────────────────────
*.iml
.idea/

# ── External Native Build ──────────────────────────────────
.externalNativeBuild
.cxx/

# ── Google Services ─────────────────────────────────────────
google-services.json

# ── Kotlin Compiler ────────────────────────────────────────
.kotlin/

# ── Editor / IDE ────────────────────────────────────────────
.vscode/

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Scratch / Test Files ───────────────────────────────────
test*.kt
test.md
Dump.kt
install.cmd
test/
skills/
scratch/
*.py

# ── Release Output Directories ────────────────────────────
app/release/