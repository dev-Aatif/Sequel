# ─────────────────────────────────────────────────────────────
# Sequel — Industry Standard Android .gitignore
# ─────────────────────────────────────────────────────────────

# ── Built Artifacts ─────────────────────────────────────────
*.apk
*.ap_
*.aab
*.dex
*.class

# ── Generated / Build Outputs ───────────────────────────────
bin/
gen/
out/
build/
*/build/
app/build/
app/release/

# ── Gradle ──────────────────────────────────────────────────
.gradle/
buildOutputCleanup/
.gradle-build/

# ── Local Configuration & Secrets (NEVER commit) ────────────
local.properties
keystore.properties
secrets.properties
*.env
*.env.*
.env
.env.local

# ── Signing & Certificates (NEVER commit) ───────────────────
*.jks
*.keystore
*.key
*.pem
*.p12
*.pfx
*.pkcs12
release.keystore

# ── Google Services & Cloud Keys ────────────────────────────
google-services.json
google-services-*.json

# ── Logs & JVM Crash Dumps ──────────────────────────────────
*.log
hs_err_pid*
replay_pid*
*.hprof
*.dump

# ── IntelliJ / Android Studio ───────────────────────────────
*.iml
.idea/
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild
.cxx/

# ── Kotlin Compiler ─────────────────────────────────────────
.kotlin/

# ── Editors & IDEs ──────────────────────────────────────────
.vscode/
*.swp
*.swo
*~
*.bak
*.tmp

# ── Operating System Junk ───────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ── Scratch, Local Scripts & Test Stubs ─────────────────────
test/
skills/
scratch/
test*.kt
test*.md
Dump.kt
install.cmd
*.py

# ── Web Development / Node ──────────────────────────────────
node_modules/
.npm/
dist/
.cache/